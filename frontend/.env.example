# ==============================================================================
# GrandStay Hotel Booking Management System - Frontend Environment Configuration
# ==============================================================================
# Copy this file to frontend/.env and configure with your backend API location.
# Vite exposes variables prefixed with VITE_ to the client bundle.
# ==============================================================================

# VITE_API_BASE_URL: [Required] Full base URL pointing to the Express backend API
# Local development default:
#   http://localhost:5000/api
# Production deployment example:
#   https://api.your-production-domain.com/api
VITE_API_BASE_URL=http://localhost:5000/api
