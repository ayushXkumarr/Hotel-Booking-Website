# ==============================================================================
# GrandStay Hotel Booking Management System - Backend Environment Configuration
# ==============================================================================
# Copy this file to backend/.env and populate with your own secure values.
# NEVER commit the actual .env file or real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Network Settings
# ------------------------------------------------------------------------------
# PORT: [Optional] Port on which Express server listens (default: 5000)
PORT=5000

# NODE_ENV: [Optional] Environment mode: 'development' | 'production' | 'test' (default: development)
NODE_ENV=development

# CLIENT_URL: [Required in Production] Frontend origin URL for CORS policy
# In local development: http://localhost:5173
# In production: https://your-production-frontend-domain.com
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# MONGODB_URI: [Required] MongoDB connection URI (Local instance or MongoDB Atlas)
# Local MongoDB example:
#   mongodb://127.0.0.1:27017/hotel_booking
# MongoDB Atlas replica set example:
#   mongodb+srv://<db_username>:<db_password>@<cluster-name>.mongodb.net/hotel_booking?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/hotel_booking

# ------------------------------------------------------------------------------
# Authentication & JWT Secrets
# ------------------------------------------------------------------------------
# JWT_SECRET: [Required] Cryptographic key used to sign and verify JSON Web Tokens.
# Generate a strong, high-entropy secret for production (e.g. `openssl rand -base64 48`).
JWT_SECRET=replace_this_with_a_secure_random_jwt_secret_key_minimum_32_characters

# JWT_EXPIRES_IN: [Optional] Expiration window for user sessions (default: 7d)
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Initial Administrator Provisioning (CLI Seeding)
# ------------------------------------------------------------------------------
# Used exclusively when executing `npm run seed:admin` to bootstrap the first administrator.
# ADMIN_NAME: [Optional] Display name for the system administrator (default: "GrandStay Administrator")
ADMIN_NAME="GrandStay Administrator"

# ADMIN_EMAIL: [Required for Seeding] Email address used to sign in to the Admin Portal
ADMIN_EMAIL=admin@example.com

# ADMIN_PASSWORD: [Required for Seeding] Password for the administrator account (minimum 6 characters)
ADMIN_PASSWORD=your_secure_admin_password_here
